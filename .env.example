# Copy to .env.local (local) or set in your hosting dashboard (production).
# The public address of the site, no trailing slash. Used for canonical URLs,
# Open Graph, structured data, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.example-salon.com
# Only when hosting under a sub-path (e.g. GitHub Pages project site): /your-repo-name
NEXT_PUBLIC_BASE_PATH=
